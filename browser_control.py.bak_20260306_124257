import subprocess, urllib.parse, time, os

def _run(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)

def _get_wid(name):
    r = _run(f"xdotool search --name '{name}'")
    ids = r.stdout.strip().split()
    return ids[0] if ids else None

def _minimize_vision():
    """Minimize Vision Assistant so it stops stealing focus."""
    wid = _get_wid(".*Vision Assistant.*")
    if not wid:
        wid = _get_wid(".*ChatOverlay.*")
    if wid:
        _run(f"xdotool windowminimize {wid}")
        time.sleep(0.3)
    return wid

def _restore_vision(wid):
    """Restore Vision Assistant window."""
    if wid:
        time.sleep(0.3)
        _run(f"xdotool windowactivate {wid}")

def _get_firefox_wid():
    r = _run("xdotool search --name '.*Mozilla Firefox.*'")
    ids = r.stdout.strip().split()
    return ids[0] if ids else None

def _firefox_cmd(keys_or_url, is_url=False, wait=0.5):
    """Send keys or navigate Firefox with Vision Assistant minimized."""
    va_wid = _minimize_vision()
    try:
        ff_wid = _get_firefox_wid()
        if not ff_wid: return False
        _run(f"xdotool windowactivate --sync {ff_wid}")
        time.sleep(0.4)
        if is_url:
            _run("xdotool key ctrl+l")
            time.sleep(0.4)
            # Use xclip to paste URL reliably
            _run(f"echo -n '{keys_or_url}' | xclip -selection clipboard")
            time.sleep(0.1)
            _run("xdotool key ctrl+a ctrl+v")
            time.sleep(0.2)
            _run("xdotool key Return")
            time.sleep(wait)
        else:
            _run(f"xdotool key {keys_or_url}")
            time.sleep(wait)
        return True
    finally:
        _restore_vision(va_wid)

def focus_ytmusic():
    """Switch to pinned YT Music tab."""
    va_wid = _minimize_vision()
    try:
        ff_wid = _get_firefox_wid()
        if not ff_wid: return False
        _run(f"xdotool windowactivate --sync {ff_wid}")
        time.sleep(0.4)
        _run("xdotool key ctrl+1")
        time.sleep(0.6)
        return True
    finally:
        _restore_vision(va_wid)

def play_liked():
    """Navigate to liked music and click play."""
    va_wid = _minimize_vision()
    try:
        ff_wid = _get_firefox_wid()
        if not ff_wid:
            return "Firefox not found."
        _run(f"xdotool windowactivate --sync {ff_wid}")
        time.sleep(0.4)
        _run("xdotool key ctrl+1")
        time.sleep(0.4)
        # Navigate to liked playlist
        _run("xdotool key ctrl+l")
        time.sleep(0.4)
        _run("echo -n 'https://music.youtube.com/library/liked_songs' | xclip -selection clipboard")
        time.sleep(0.1)
        _run("xdotool key ctrl+a ctrl+v")
        time.sleep(0.2)
        _run("xdotool key Return")
        time.sleep(3.5)
        # Click shuffle play button (confirmed coords x=903 y=719)
        _run("xdotool mousemove 903 719")
        time.sleep(0.3)
        _run("xdotool click 1")
        time.sleep(0.5)
        return "Playing your liked music."
    finally:
        _restore_vision(va_wid)

def play_music(query=None):
    if not query:
        return play_liked()
    va_wid = _minimize_vision()
    try:
        ff_wid = _get_firefox_wid()
        if not ff_wid: return "Firefox not found."
        _run(f"xdotool windowactivate --sync {ff_wid}")
        time.sleep(0.4)
        _run("xdotool key ctrl+1")
        time.sleep(0.4)
        q = urllib.parse.quote(query)
        url = f"https://music.youtube.com/search?q={q}"
        _run("xdotool key ctrl+l")
        time.sleep(0.4)
        _run(f"echo -n '{url}' | xclip -selection clipboard")
        time.sleep(0.1)
        _run("xdotool key ctrl+a ctrl+v")
        time.sleep(0.2)
        _run("xdotool key Return")
        time.sleep(3.0)
        # Click first song result - roughly at x=400, y=280
        _run(f"xdotool mousemove --window {ff_wid} 400 280")
        time.sleep(0.2)
        _run("xdotool doubleclick 1")
        return f"Playing: {query}"
    finally:
        _restore_vision(va_wid)

def media_pause():
    focus_ytmusic()
    _firefox_cmd("k", wait=0.2)
    return "Toggled play/pause."

def media_next():
    focus_ytmusic()
    _firefox_cmd("shift+n", wait=0.2)
    return "Next track."

def media_prev():
    focus_ytmusic()
    _firefox_cmd("shift+p", wait=0.2)
    return "Previous track."

def web_search(query):
    q = urllib.parse.quote(query)
    _run(f"xdg-open 'https://www.google.com/search?q={q}'")
    return f"Searching: {query}"

def youtube_search(query):
    q = urllib.parse.quote(query)
    _run(f"xdg-open 'https://www.youtube.com/results?search_query={q}'")
    return f"Searching YouTube for: {query}"

INTENTS = [
    (["play my liked","play liked","my liked music","liked songs",
      "play my playlist","my playlist","play my music","play my songs",
      "play music","start music","music please","some music"],
        lambda q: play_liked()),
    (["play song ","play ","put on ","listen to ","play me "],
        lambda q: play_music(q) if q else play_liked()),
    (["pause","stop music","pause music","stop the music"],
        lambda q: media_pause()),
    (["next song","next track","skip"],      lambda q: media_next()),
    (["previous","go back","last song"],     lambda q: media_prev()),
    (["search youtube ","youtube search"],   lambda q: youtube_search(q)),
    (["youtube music","open music"],         lambda q: "Focused." if focus_ytmusic() else "Firefox not found."),
    (["search for ","google ","look up "],   lambda q: web_search(q)),
]

def handle_browser_command(text):
    t = text.lower().strip()
    for triggers, fn in INTENTS:
        for trigger in triggers:
            if trigger in t:
                idx = t.find(trigger)
                query = text[idx+len(trigger):].strip().strip(".,!?\"'")
                try: return fn(query)
                except Exception as e: return f"Browser error: {e}"
    return None
