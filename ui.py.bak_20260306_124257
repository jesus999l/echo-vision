    def _on_mousewheel(self,e):
        # Find the canvas under cursor and scroll it
        w=e.widget
        for _ in range(10):
            if isinstance(w,tk.Canvas):
                delta=0
                if e.num==4: delta=-3
                elif e.num==5: delta=3
                else: delta=int(-1*(e.delta/120))
                w.yview_scroll(delta,"units")
                return
            try: w=w.master
            except: break

