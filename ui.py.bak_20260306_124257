    def _refresh_full_cal(self,cal_root):
        self._show_full_calendar()

    def _render_cal_content(self):
        for w in self._cal_content_frame.winfo_children(): w.destroy()
        if self.cal_view=="month": self._cal_month(self._cal_content_frame)
        elif self.cal_view=="week": self._cal_week(self._cal_content_frame)
        elif self.cal_view=="day": self._cal_day(self._cal_content_frame)
        else: self._cal_list(self._cal_content_frame)

    def _cal_nav(self,d):
        if self.cal_view=="month":
            m=self.cal_date.month+d; y=self.cal_date.year
            if m>12: m=1; y+=1
            elif m<1: m=12; y-=1
            try: self.cal_date=self.cal_date.replace(year=y,month=m,day=1)
            except: self.cal_date=datetime.date(y,m,1)
        elif self.cal_view=="week": self.cal_date+=datetime.timedelta(weeks=d)
        else: self.cal_date+=datetime.timedelta(days=d)

    def _switch_cal_view(self,view):
        self.cal_view=view

    def _get_events(self,s,e):
        raw=get_calendar_events(s.timestamp(),e.timestamp())
        return self._filter_events(raw)

