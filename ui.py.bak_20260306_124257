                         fg=WARN if _streak>=3 else TEXT3,
                         font=("Segoe UI",8,"bold")).pack(side="left",padx=4)
            period_lbl=f"{h['frequency'].upper()}  ·  {count}/{target}"
            tk.Label(top,text=period_lbl,bg=BG3,fg=TEXT3,font=("Segoe UI",7)).pack(side="right")

            # Progress bar
            bar_frame=tk.Frame(card,bg=BG2,height=6); bar_frame.pack(fill="x",pady=(6,4))
            bar_frame.pack_propagate(False)
            pct=min(1.0,count/target)
            if pct>0:
                fill=tk.Frame(bar_frame,bg=ACCENT3 if done else ACCENT2)
                fill.place(x=0,y=0,relwidth=pct,relheight=1)

            # Action row
            act=tk.Frame(card,bg=BG3); act.pack(fill="x")
            if not done:
                check=tk.Label(act,text="＋ Log Once",bg=ACCENT2,fg=BG,
                               font=("Segoe UI",8,"bold"),padx=8,pady=3,cursor="hand2")
