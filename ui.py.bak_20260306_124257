        purge_old_habits()
        self._build()
        self.bind_all("<MouseWheel>",self._on_mousewheel)
        self.bind_all("<Button-4>",self._on_mousewheel)
        self.bind_all("<Button-5>",self._on_mousewheel)
        self.bind("<Escape>",lambda e:self._close_panels())
        self.after(2000,self._update_badges)
        self.after(1500,self._show_morning_briefing)
        self.after(5000,self._check_event_toasts)
