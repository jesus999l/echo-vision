def _lighten(h):
    try:
        r,g,b=int(h[1:3],16),int(h[3:5],16),int(h[5:7],16)
        return f"#{min(255,r+30):02x}{min(255,g+30):02x}{min(255,b+30):02x}"
    except: return h

def fmt_time(dt):
    if SETTINGS.get("time_format","12h")=="24h":
        return dt.strftime("%H:%M")
    else:
        return dt.strftime("%I:%M %p").lstrip("0")

def fast_card(parent,bg,border,**kwargs):
    """Lightweight card - single frame, no nesting."""
    return tk.Frame(parent,bg=bg,padx=10,pady=6,
                   highlightthickness=1,highlightbackground=border)

def sbtn(parent,text,cmd,bg=ACCENT,fg=WHITE,px=10,py=4):
    b=tk.Label(parent,text=text,bg=bg,fg=fg,font=FONT_TINY,padx=px,pady=py,cursor="hand2")
    b.bind("<Button-1>",lambda e:cmd())
    b.bind("<Enter>",lambda e:b.configure(bg=_lighten(bg)))
    b.bind("<Leave>",lambda e:b.configure(bg=bg))
    return b

def scrollable(parent,bg=BG2):
    f=tk.Frame(parent,bg=bg)
    c=tk.Canvas(f,bg=bg,highlightthickness=0,bd=0)
    sb=tk.Scrollbar(f,orient="vertical",command=c.yview,bg=bg,troughcolor=bg,relief="flat")
    inner=tk.Frame(c,bg=bg)
    inner.bind("<Configure>",lambda e:c.configure(scrollregion=c.bbox("all")))
    win=c.create_window((0,0),window=inner,anchor="nw")
    c.bind("<Configure>",lambda e:c.itemconfig(win,width=e.width))
    c.configure(yscrollcommand=sb.set)
    c.pack(side="left",fill="both",expand=True)
    sb.pack(side="right",fill="y")
    def _scroll(e): c.yview_scroll(int(-1*(e.delta/120)),"units")
    c.bind("<MouseWheel>",_scroll)
    inner.bind("<MouseWheel>",_scroll)
    return f,inner

def purge_old_habits():
    import sqlite3
    from config import DB_PATH
    cutoff=time.time()-86400
    conn=sqlite3.connect(DB_PATH)
    conn.execute("DELETE FROM habit_completions WHERE timestamp < ?",(cutoff,))
    conn.commit(); conn.close()


class EventDialog(tk.Toplevel):
    def __init__(self,master,event=None,default_dt=None,on_save=None):
        super().__init__(master)
        self.title("Add Event" if event is None else "Edit Event")
        self.geometry("400x480")
        self.configure(bg=BG2)
        self.resizable(False,False)
        self.on_save=on_save
        self.event=event
        self.sel_color=tk.StringVar(value=event["color"] if event and event["color"] else EVENT_COLORS[0])
        dt=default_dt or (datetime.datetime.fromtimestamp(event["start_time"]) if event else datetime.datetime.now())
        self._build(dt)
        self.transient(master)
        self.attributes('-topmost', True)
        self.lift()
        self.focus_force()
        self.update()

    def _build(self,dt):
        def lbl(txt):
            tk.Label(self,text=txt,bg=BG2,fg=TEXT3,font=("Segoe UI",8,"bold")).pack(anchor="w",padx=16,pady=(8,2))

        lbl("TITLE")
        self.t_entry=tk.Entry(self,bg=BG3,fg=TEXT,insertbackground=ACCENT,relief="flat",
                              font=FONT_BODY,highlightthickness=1,highlightbackground=BORDER)
        self.t_entry.pack(fill="x",padx=16,ipady=6)
        if self.event: self.t_entry.insert(0,self.event["title"])

        lbl("DESCRIPTION")
        self.d_entry=tk.Text(self,bg=BG3,fg=TEXT,insertbackground=ACCENT,relief="flat",
                             font=FONT_SMALL,height=3,highlightthickness=1,
                             highlightbackground=BORDER,wrap="word")
        self.d_entry.pack(fill="x",padx=16)
        if self.event and self.event["description"]:
            self.d_entry.insert("1.0",self.event["description"])

        lbl("DATE  (Year / Month / Day)")
        row=tk.Frame(self,bg=BG2); row.pack(fill="x",padx=16)
        self.yr=tk.StringVar(value=str(dt.year))
        self.mo=tk.StringVar(value=f"{dt.month:02d}")
        self.dy=tk.StringVar(value=f"{dt.day:02d}")
        for var,vals,w in [
            (self.yr,[str(y) for y in range(2024,2036)],7),
            (self.mo,[f"{m:02d}" for m in range(1,13)],5),
            (self.dy,[f"{d:02d}" for d in range(1,32)],5)
        ]:
            om=tk.OptionMenu(row,var,*vals)
            om.config(bg=BG3,fg=TEXT,relief="flat",font=FONT_SMALL,
                      highlightthickness=1,highlightbackground=BORDER,width=w)
            om["menu"].config(bg=BG3,fg=TEXT,activebackground=ACCENT)
            om.pack(side="left",padx=(0,4))

        lbl("TIME  (Hour : Min)  + Duration (min)")
        row2=tk.Frame(self,bg=BG2); row2.pack(fill="x",padx=16)
        self.hr=tk.StringVar(value=f"{dt.hour:02d}")
        self.mn=tk.StringVar(value=f"{dt.minute:02d}")
        self.dur=tk.StringVar(value="60")
        if self.event and self.event["end_time"]:
            dur_min=int((self.event["end_time"]-self.event["start_time"])/60)
            self.dur.set(str(dur_min))
        for var,vals,w in [
            (self.hr,[f"{h:02d}" for h in range(24)],5),
            (self.mn,[f"{m:02d}" for m in range(0,60,5)],5),
            (self.dur,["15","30","45","60","90","120","180","240"],6)
        ]:
            om=tk.OptionMenu(row2,var,*vals)
            om.config(bg=BG3,fg=TEXT,relief="flat",font=FONT_SMALL,
                      highlightthickness=1,highlightbackground=BORDER,width=w)
            om["menu"].config(bg=BG3,fg=TEXT,activebackground=ACCENT)
            om.pack(side="left",padx=(0,4))

        self.allday=tk.BooleanVar(value=bool(self.event and self.event["all_day"]))
        tk.Checkbutton(self,text="All day event",variable=self.allday,
                       bg=BG2,fg=TEXT2,selectcolor=BG3,activebackground=BG2,
                       font=FONT_SMALL,highlightthickness=0).pack(anchor="w",padx=16,pady=4)

        lbl("COLOR")
        crow=tk.Frame(self,bg=BG2); crow.pack(anchor="w",padx=16)
        self.cprev=tk.Label(crow,bg=self.sel_color.get(),text="  ●  ",fg=WHITE,font=("Segoe UI",8,"bold"))
        self.cprev.pack(side="left",padx=(0,6))
        for c in EVENT_COLORS:
            sw=tk.Label(crow,bg=c,width=3,height=1,cursor="hand2")
            sw.pack(side="left",padx=1)
            sw.bind("<Button-1>",lambda e,col=c:(self.sel_color.set(col),self.cprev.configure(bg=col)))

        br=tk.Frame(self,bg=BG2); br.pack(fill="x",padx=16,pady=14)
        sbtn(br,"SAVE",self._save,bg=ACCENT).pack(side="right",padx=(4,0))
        sbtn(br,"CANCEL",self.destroy,bg=BG3,fg=TEXT2).pack(side="right")
        if self.event:
            def do_delete():
                from memory import delete_calendar_event
                delete_calendar_event(self.event["id"])
                self.destroy()
                if self.on_save: self.on_save()
            sbtn(br,"DELETE",do_delete,bg=DANGER,fg=WHITE).pack(side="left")

    def _save(self):
        title=self.t_entry.get().strip()
        if not title: return
        desc=self.d_entry.get("1.0","end").strip()
        try:
            dt=datetime.datetime(int(self.yr.get()),int(self.mo.get()),int(self.dy.get()),
                                 int(self.hr.get()),int(self.mn.get()))
            start=dt.timestamp()
            end=start+int(self.dur.get())*60
        except: return
        color=self.sel_color.get()
        allday=int(self.allday.get())
        if self.event:
            update_calendar_event(self.event["id"],title,start,end,desc,allday,color)
        else:
            add_calendar_event(title,start,end,desc,allday,color)
        self.destroy()
        if self.on_save: self.on_save()


class ChatOverlay(tk.Toplevel):
