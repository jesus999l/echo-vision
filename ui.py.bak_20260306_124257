            name_row=tk.Frame(top,bg=BG3); name_row.pack(side="left",fill="x",expand=True)
            tk.Label(name_row,text=h["name"],bg=BG3,fg=TEXT2 if done else TEXT,
                     font=FONT_SMALL,anchor="w").pack(side="left")
