def _get_theme_colors(override_theme=None, override_accent=None):
    s = load_settings()  # always fresh from disk
    theme_name = override_theme or s.get("theme","dark")
    accent = override_accent or s.get("accent_color","#7c6af7")
    t = THEMES.get(theme_name, THEMES["dark"])
    return {**t, "ACCENT": accent}

def _apply_color_globals(theme=None, accent=None):
    global BG,BG2,BG3,BG4,PANEL,BORDER,TEXT,TEXT2,TEXT3,ACCENT,ACCENT2,ACCENT3,WARN,DANGER
