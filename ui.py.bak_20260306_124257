        """Full UI rebuild with new theme."""
        global SETTINGS, BG,BG2,BG3,BG4,PANEL,BORDER,TEXT,TEXT2,TEXT3,ACCENT,ACCENT2,ACCENT3,WARN,DANGER
        SETTINGS["theme"] = theme_name
        if accent_color:
            SETTINGS["accent_color"] = accent_color
        save_settings(SETTINGS)
        _apply_color_globals(theme=theme_name, accent=accent_color)
        # Destroy and rebuild entire UI
        page = self.active_page
        # Save chat history before rebuild
        try:
            chat_content = self.chat_text.get("1.0","end")
        except:
            chat_content = ""
        for w in self.winfo_children():
            w.destroy()
        self.configure(bg=BG)
        self.panel_open = False
        self.chat_open  = False
        self.bubble_open = False
        self._build()
        # Restore chat
        if chat_content.strip():
            self.after(400, lambda: self._restore_chat(chat_content))
        if page:
            self.after(200, lambda: self.open_page(page))
        self.after(300, lambda: self.append_chat("system", f"Theme: {theme_name}"))

