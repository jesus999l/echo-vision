        cat_groups=defaultdict(list)
        cat_colors_map={"general":TEXT3,"health":"#a5d6a7","mind":"#ce93d8","work":"#4fc3f7","fitness":"#ffcc80"}
        for h in habits:
            cat_groups[h.get("category") or "general"].append(h)
        habits_iter=[]
        for cat_order in ["health","fitness","mind","work","general"]:
            if cat_order in cat_groups:
                if len(cat_groups)>1:
