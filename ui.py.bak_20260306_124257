    def send_message(self):
        user_text=self.input_box.get().strip()
        if not user_text: return
        self.append_chat("you",user_text); self.input_box.delete(0,"end")
        # Only use screenshot if user explicitly asks about screen/image
        screen_keywords = ["screen","image","picture","photo","what do you see","what's on","ocr","capture"]
        use_screen = any(k in user_text.lower() for k in screen_keywords)
        screenshot = self.last_screenshot if use_screen else None
        ocr = self.last_ocr if use_screen else ""
        try:
            from multi_model import route_model
            has_img = bool(use_screen and screenshot and os.path.exists(screenshot))
            routed = route_model(user_text, has_image=has_img, available_models=self.models)
        except:
            routed = self.model.get()
        threading.Thread(target=self._handle_message,args=(user_text,routed,ocr,screenshot,self.task_mode.get()),daemon=True).start()

    def _handle_message(self,user_text,model,ocr,screenshot,task_mode):
        # Check browser commands first - instant, no AI needed
        try:
            from browser_control import handle_browser_command
            result = handle_browser_command(user_text)
            if result:
                self.after(0, lambda r=result: self.append_chat("ai", r))
                return
        except: pass
        # Vision click commands
        click_triggers = ["click the","click on","press the","find and click"]
        t_lower = user_text.lower()
        if any(t in t_lower for t in click_triggers):
            def _do_vision_click():
                try:
                    from vision_clicker import vision_action
                    import sys,os
                    sys.path.insert(0,os.path.expanduser("~/vision_assistant"))
                    result = vision_action(user_text)
                    self.after(0, lambda r=result: self.append_chat("ai", r))
                except Exception as e:
                    self.after(0, lambda: self.append_chat("ai", f"Vision error: {e}"))
            import threading
            threading.Thread(target=_do_vision_click,daemon=True).start()
            self.after(0, lambda: self.append_chat("system","👁 Looking at screen..."))
            return
        # Auto-screenshot for visual queries
        visual_triggers = ["what do you see","what's on","what is on","look at",
                          "can you see","describe","what's happening","screenshot",
                          "what am i","screen","help me with this","analyze"]
        if not screenshot and any(t in user_text.lower() for t in visual_triggers):
            try:
                from capture import capture_area, ocr_image
                import tempfile, os
                tmp = tempfile.mktemp(suffix=".png")
                capture_area(tmp, fullscreen=True)
                ocr = ocr_image(tmp)
                screenshot = tmp
                ocr_text = ocr
                self.after(0, lambda: self.append_chat("system","📸 Captured screen."))
            except: pass
        def ui_callback(action_results):
            for ok,msg in action_results:
                self.after(0,lambda m=msg,o=ok:self.append_chat("system" if not o else "task",m))
            if self.active_page=="calendar" and self.panel_open:
                self.after(100,lambda:self.open_page("calendar"))
        if task_mode:
            task=parse_task(user_text,model)
            action=task.get("action","chat"); expl=task.get("explanation","")
            if action!="chat":
                self.append_chat("task",f"{action}: {expl}")
                ok,result=execute_task(task)
                if action=="run_command": self.append_chat("output",result)
                elif not ok: self.append_chat("system",f"Failed: {result}")
                else:
                    r=ask(f"I just did: {action} — {expl}. {user_text}",model=model,ocr_text=ocr,screenshot_path=screenshot,ui_callback=ui_callback)
                    self.append_chat("ai",r)
                    self._speak_response(r)
            else:
                r=ask(user_text,model=model,ocr_text=ocr,screenshot_path=screenshot,ui_callback=ui_callback)
                self.append_chat("ai",r)
                self._speak_response(r)
        else:
            r=ask(user_text,model=model,ocr_text=ocr,screenshot_path=screenshot,ui_callback=ui_callback)
            self.append_chat("ai",r)
            self._speak_response(r)

