                sbtn(act,"Delete",lambda eid=ev["id"]:(delete_calendar_event(eid),self._show_full_calendar()),
                     bg=DANGER,fg=WHITE,px=10,py=3).pack(side="left")
                for w in (card,badge,content):
                    w.bind("<Button-1>",lambda e,ed=dict(ev):self._event_detail(ed))

    def _ev_icon(self,ev):
        t=ev.get("title","")
        if "Journal:" in t or any(t.startswith(e) for e in ["🙂","😔","😐","😊","🤩"]): return "✦","#a5d6a7"
        if "Habit:" in t or t.startswith("◈"): return "◈","#4fc3f7"
        if "Goal:" in t or "Due:" in t or t.startswith("🎯"): return "🎯","#ce93d8"
        return "◆",ev.get("color") or "#7c6af7"

    def _event_pill(self,parent,ev):
        ev_data={k:ev[k] for k in ev.keys()} if not isinstance(ev,dict) else dict(ev)
        icon,icon_color=self._ev_icon(ev_data)
        bg=ev_data.get("color") or "#7c6af7"
        t=fmt_time(datetime.datetime.fromtimestamp(ev_data["start_time"]))
        f=tk.Frame(parent,bg=bg,cursor="hand2")
        badge=tk.Frame(f,bg=icon_color,width=32); badge.pack(side="left",fill="y"); badge.pack_propagate(False)
        tk.Label(badge,text=icon,bg=icon_color,fg=WHITE,font=("Segoe UI",14)).pack(expand=True)
        content=tk.Frame(f,bg=bg,padx=8,pady=5); content.pack(side="left",fill="both",expand=True)
        title_short=ev_data["title"]
        for prefix in ["✓ Goal: ","◈ Habit: ","🎯 Due: "]:
            if title_short.startswith(prefix): title_short=title_short[len(prefix):]; break
        lbl=tk.Label(content,text=f"{t}  {title_short[:22]}",bg=bg,fg=WHITE,font=("Segoe UI",10,"bold"))
        lbl.pack(anchor="w",pady=2)
        for w in (f,badge,content,lbl):
            w.bind("<ButtonPress-1>",lambda e,d=ev_data:self._drag_start_ev(e,d))
            w.bind("<B1-Motion>",lambda e:self._drag_motion(e))
            w.bind("<ButtonRelease-1>",lambda e:self._drag_end(e))
            w.bind("<Double-Button-1>",lambda e,d=ev_data:self._open_edit(d))
            w.bind("<Button-1>",lambda e,d=ev_data:self._event_detail(d))
        return f

    def _drag_start_ev(self,e,ev):
        self._drag_event=ev; self._drag_origin=(e.x_root,e.y_root); self._did_drag=False

    def _drag_motion(self,e):
        if not self._drag_origin: return
        dx=e.x_root-self._drag_origin[0]; dy=e.y_root-self._drag_origin[1]
        if abs(dx)>8 or abs(dy)>8: self._did_drag=True

    def _drag_end(self,e):
        if not self._drag_event or not self._drag_origin: return
        did=self._did_drag; evdata=self._drag_event
        self._drag_event=None; self._drag_origin=None; self._did_drag=False
        if did: self._move_event_dialog(evdata)

    def _open_edit(self,ev):
        if not isinstance(ev,dict): ev={k:ev[k] for k in ev.keys()}
        EventDialog(self,event=ev,on_save=self._page_calendar)

    def _move_event_dialog(self,ev):
        win=tk.Toplevel(self); win.title("Move Event"); win.geometry("340x200")
        win.configure(bg=BG2); win.attributes('-topmost',True); win.lift(); win.focus_force()
        orig=datetime.datetime.fromtimestamp(ev["start_time"])
        tk.Label(win,text=f"Move:  {ev['title']}",bg=BG2,fg=TEXT,font=("Segoe UI",10,"bold")).pack(anchor="w",padx=16,pady=(14,2))
        tk.Label(win,text=orig.strftime("Currently: %A %b %d, %Y  %H:%M"),bg=BG2,fg=TEXT3,font=FONT_TINY).pack(anchor="w",padx=16,pady=(0,8))
        tk.Label(win,text="NEW DATE",bg=BG2,fg=TEXT3,font=("Segoe UI",8,"bold")).pack(anchor="w",padx=16)
        row=tk.Frame(win,bg=BG2); row.pack(fill="x",padx=16,pady=4)
        yr=tk.StringVar(value=str(orig.year)); mo=tk.StringVar(value=f"{orig.month:02d}"); dy=tk.StringVar(value=f"{orig.day:02d}")
        for var,vals,w in [(yr,[str(y) for y in range(2024,2036)],7),(mo,[f"{m:02d}" for m in range(1,13)],5),(dy,[f"{d:02d}" for d in range(1,32)],5)]:
            om=tk.OptionMenu(row,var,*vals); om.config(bg=BG3,fg=TEXT,relief="flat",font=FONT_SMALL,highlightthickness=1,highlightbackground=BORDER,width=w)
            om["menu"].config(bg=BG3,fg=TEXT,activebackground=ACCENT); om.pack(side="left",padx=(0,4))
        def do_move():
            try:
                new_dt=datetime.datetime(int(yr.get()),int(mo.get()),int(dy.get()),orig.hour,orig.minute)
                diff=new_dt.timestamp()-orig.timestamp()
                ns=ev["start_time"]+diff; ne=(ev["end_time"] or ev["start_time"]+3600)+diff
                update_calendar_event(ev["id"],ev["title"],ns,ne,ev.get("description") or "",ev["all_day"],ev.get("color") or ACCENT)
                win.destroy(); self.cal_date=new_dt.date(); self._show_full_calendar()
            except Exception as ex: tk.Label(win,text=f"Error: {ex}",bg=BG2,fg=DANGER,font=FONT_TINY).pack()
        br=tk.Frame(win,bg=BG2); br.pack(fill="x",padx=16,pady=12)
        sbtn(br,"MOVE",do_move,bg=ACCENT).pack(side="right",padx=(4,0))
        sbtn(br,"CANCEL",win.destroy,bg=BG3,fg=TEXT2).pack(side="right")

    def _cal_month(self,parent):
        y,m=self.cal_date.year,self.cal_date.month
        self.cal_label.config(text=f"{calendar.month_name[m].upper()}  {y}")
        sf,inner=scrollable(parent,bg=BG); sf.pack(fill="both",expand=True)
        hdr=tk.Frame(inner,bg=BG); hdr.pack(fill="x",pady=(0,4))
        for d in ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]:
            tk.Label(hdr,text=d,bg=BG,fg=TEXT3,font=("Segoe UI",10,"bold")).pack(side="left",expand=True)
        last=calendar.monthrange(y,m)[1]
        events=self._get_events(datetime.datetime(y,m,1),datetime.datetime(y,m,last,23,59))
        ev_by_day={}
        for ev in events:
            if not isinstance(ev,dict): ev={k:ev[k] for k in ev.keys()}
            d=datetime.date.fromtimestamp(ev["start_time"]); ev_by_day.setdefault(d,[]).append(ev)
        today=datetime.date.today()
        grid_frame=tk.Frame(inner,bg=BG); grid_frame.pack(fill="both",expand=True)
        for col in range(7): grid_frame.columnconfigure(col,weight=1,uniform="col")
        for week_i,week in enumerate(calendar.monthcalendar(y,m)):
            grid_frame.rowconfigure(week_i,weight=1,uniform="row")
            for col_i,day in enumerate(week):
                cell=tk.Frame(grid_frame,bg=BG3 if day else BG,highlightthickness=1,highlightbackground=BORDER)
