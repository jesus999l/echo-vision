                habits_iter.extend(cat_groups[cat_order])
        # Pre-calculate all streaks in one DB call
        import datetime as _dt2
        from memory import get_db as _sdb
        _sconn=_sdb()
        _streak_cache={}
        for _h in habits_iter:
            _s=0; _d2=_dt2.date.today()
            for _ in range(60):
                _ds2=_d2.isoformat()
                _cnt=_sconn.execute("SELECT COUNT(*) FROM habit_completions WHERE habit_id=? AND date_str=?",(_h["id"],_ds2)).fetchone()[0]
                if _cnt: _s+=1; _d2-=_dt2.timedelta(days=1)
                else: break
            _streak_cache[_h["id"]]=_s
        _sconn.close()

        for h in habits_iter:
            target=h["target"] if h["target"] else 1
            period=h["period"] if h["period"] else h["frequency"]
