    def _on_configure(self, e=None):
        if hasattr(self,"_conf_job"):
            try: self.after_cancel(self._conf_job)
            except: pass
        self._conf_job = self.after(120, self._reposition_panel)

    def _reposition_panel(self):
        # Debounce - cancel pending call, reschedule
        if hasattr(self,"_repos_job"):
            try: self.after_cancel(self._repos_job)
            except: pass
        self._repos_job = self.after(150, self._do_reposition)

    def _do_reposition(self):
        if self.panel_open:
            w=self.winfo_width(); h=self.winfo_height()
            if w<100: return
            side=load_settings().get("menu_side","left")
            x=w-self._panel_width if side=="right" else 0
            try: self._scrim.place(x=0,y=0,relwidth=1,relheight=1); self._scrim.lift()
            except: pass
            self.side_panel.place(x=x,y=0,width=self._panel_width,height=h)
            self.side_panel.lift()
        try: self._place_bubble_btn()
        except: pass

    def _close_panels(self):
