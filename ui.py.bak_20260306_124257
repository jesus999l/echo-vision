    # ── TOAST NOTIFICATIONS ───────────────────────────────────
    def show_toast(self, message, color=None, duration=4000):
        """Slide-in toast notification from top of window."""
        if color is None: color = ACCENT
        toast = tk.Frame(self, bg=color, padx=16, pady=10,
                        highlightthickness=0)
        toast.place(relx=0.5, y=-40, anchor="n")
        tk.Label(toast, text=message, bg=color, fg=WHITE,
                font=("Segoe UI", 10, "bold")).pack(side="left")
        close = tk.Label(toast, text="  ✕", bg=color, fg=WHITE,
                         cursor="hand2", font=("Segoe UI", 10))
        close.pack(side="right")
        close.bind("<Button-1>", lambda e: toast.destroy())

        # Slide in
        def slide_in(y=0):
            if y < 12:
                toast.place(relx=0.5, y=y, anchor="n")
                self.after(16, lambda: slide_in(y + 4))
        slide_in()

        # Auto dismiss
        def dismiss():
            try: toast.destroy()
            except: pass
        self.after(duration, dismiss)

    def _check_event_toasts(self):
        """Check for upcoming events and show in-app toasts."""
        try:
            from briefing import check_upcoming_events as _chk
            import time as _t, datetime as _dt
            from memory import get_calendar_events as _gce
            now = _t.time()
            window = now + 16*60
            evs = _gce(now, window)
            for ev in evs:
                eid = ev["id"]
                if not hasattr(self, "_toasted_events"):
                    self._toasted_events = set()
                if eid not in self._toasted_events:
                    mins = int((ev["start_time"] - now)/60)
                    if mins <= 15:
                        self._toasted_events.add(eid)
                        self.after(0, lambda m=mins, t=ev["title"]:
                            self.show_toast(f"⏰ In {m} min: {t}", color=WARN, duration=6000))
        except: pass
        self.after(60000, self._check_event_toasts)

    # ── AI VOICE COMMANDS ─────────────────────────────────────
    def _process_voice_command(self, text):
        """Parse voice input for quick commands before sending to AI."""
        t = text.lower().strip()
        import datetime as _dt

        # "add task X"
        if t.startswith("add task "):
            title = text[9:].strip()
            add_goal(title, category="personal")
            self.show_toast(f"✓ Task added: {title}", color=ACCENT)
            if self.active_page == "tasks": self.open_page("tasks")
            return True

        # "add habit X"
        if t.startswith("add habit "):
            name = text[10:].strip()
            add_habit(name, frequency="daily")
            self.show_toast(f"◈ Habit added: {name}", color=ACCENT2)
            if self.active_page == "habits": self.open_page("habits")
            return True

        # "log habit X" / "done habit X"
        if t.startswith(("log habit ","done habit ","complete habit ")):
            name = t.split("habit ",1)[1].strip()
            from memory import get_habits as _gh, complete_habit_once as _ch
            habits = _gh()
            match = next((h for h in habits if name in h["name"].lower()), None)
            if match:
                _ch(match["id"])
                self.show_toast(f"◈ Logged: {match['name']}", color=ACCENT3)
                return True

        # "what's on my calendar" / "today's events"
        if any(p in t for p in ["calendar","events today","what's on","schedule"]):
            from briefing import get_morning_briefing, format_briefing_text
            b = get_morning_briefing()
            self.append_chat("system", format_briefing_text(b))
            if not self.bubble_open: self._toggle_bubble()
            return True

        # "start timer" / "pomodoro"
        if any(p in t for p in ["start timer","pomodoro","focus timer"]):
            self._show_pomodoro()
            return True

        return False  # not a command, send to AI

    # ── POMODORO TIMER ────────────────────────────────────────
    def _show_pomodoro(self):
        """Floating Pomodoro timer window."""
        if hasattr(self, "_pom_win") and self._pom_win.winfo_exists():
            self._pom_win.lift(); return

        from pomodoro import PomodoroTimer
        win = tk.Toplevel(self)
        win.title("Focus Timer")
        win.geometry("240x320")
        win.configure(bg=BG2)
        win.attributes("-topmost", True)
        win.resizable(False, False)
        self._pom_win = win

        # Header
        tk.Label(win, text="⏱  FOCUS TIMER", bg=BG2, fg=ACCENT,
                font=("Segoe UI", 11, "bold")).pack(pady=(14,0))

        # Task link
        tk.Label(win, text="Linked task:", bg=BG2, fg=TEXT3,
                font=FONT_TINY).pack(pady=(8,0))
        goals = get_goals()
        task_var = tk.StringVar(value="None")
        task_names = ["None"] + [g["title"][:30] for g in goals if g["status"]!="done"]
        tk.OptionMenu(win, task_var, *task_names).pack(fill="x", padx=16)

        # Timer display
        time_lbl = tk.Label(win, text="25:00", bg=BG2, fg=TEXT,
                           font=("Segoe UI", 42, "bold"))
        time_lbl.pack(pady=(12,0))

        mode_lbl = tk.Label(win, text="WORK", bg=BG2, fg=ACCENT2,
                           font=("Segoe UI", 9, "bold"))
        mode_lbl.pack()

        sessions_lbl = tk.Label(win, text="Sessions: 0", bg=BG2, fg=TEXT3,
                               font=FONT_TINY)
        sessions_lbl.pack(pady=(4,0))

        # Progress bar
        pb = tk.Canvas(win, bg=BG3, height=6, highlightthickness=0)
        pb.pack(fill="x", padx=16, pady=8)

        def update_pb(progress):
            pb.delete("all")
            w = pb.winfo_width()
            if w > 0:
                pb.create_rectangle(0,0,int(w*progress),6,fill=ACCENT,outline="")

        pom = PomodoroTimer(
            on_tick=lambda s,m: (
                win.after(0, lambda: time_lbl.config(text=pom.fmt_time())),
                win.after(0, lambda: update_pb(pom.progress))
            ),
            on_complete=lambda mode,sess: (
                win.after(0, lambda: mode_lbl.config(
                    text="BREAK" if mode=="break" else "WORK",
                    fg=ACCENT3 if mode=="break" else ACCENT2)),
                win.after(0, lambda: sessions_lbl.config(text=f"Sessions: {sess}")),
                win.after(0, lambda: self.show_toast(
                    f"🍅 Session done! Time for a {'break' if mode=='break' else 'focus session'}",
                    color=ACCENT3 if mode=="break" else ACCENT))
            )
        )

        # Controls
        ctrl = tk.Frame(win, bg=BG2); ctrl.pack(pady=8)
        start_btn = tk.Label(ctrl, text="▶ Start", bg=ACCENT, fg=WHITE,
                            font=("Segoe UI",10,"bold"), padx=12, pady=6, cursor="hand2")
        start_btn.pack(side="left", padx=4)

        def toggle_start():
            if not pom._running:
                pom.start()
                start_btn.configure(text="⏸ Pause", bg=WARN)
            elif pom._paused:
                pom.pause()
                start_btn.configure(text="⏸ Pause", bg=WARN)
            else:
                pom.pause()
                start_btn.configure(text="▶ Resume", bg=ACCENT)
        start_btn.bind("<Button-1>", lambda e: toggle_start())

        skip_btn = tk.Label(ctrl, text="⏭ Skip", bg=BG3, fg=TEXT2,
                           font=("Segoe UI",10,"bold"), padx=12, pady=6, cursor="hand2")
        skip_btn.pack(side="left", padx=4)
        skip_btn.bind("<Button-1>", lambda e: pom.skip())

        stop_btn = tk.Label(ctrl, text="■ Stop", bg=DANGER, fg=WHITE,
                           font=("Segoe UI",10,"bold"), padx=12, pady=6, cursor="hand2")
        stop_btn.pack(side="left", padx=4)
        def do_stop():
            pom.stop()
            time_lbl.configure(text="25:00")
            mode_lbl.configure(text="WORK", fg=ACCENT2)
            start_btn.configure(text="▶ Start", bg=ACCENT)
            pb.delete("all")
        stop_btn.bind("<Button-1>", lambda e: do_stop())

        # Settings
        cfg = tk.Frame(win, bg=BG2); cfg.pack(fill="x", padx=16, pady=(4,12))
        tk.Label(cfg, text="Work:", bg=BG2, fg=TEXT3, font=FONT_TINY).pack(side="left")
        work_spin = tk.Spinbox(cfg,from_=1,to=60,width=3,bg=BG3,fg=TEXT,
                               relief="flat",font=FONT_TINY,
                               command=lambda: setattr(pom,"work_mins",int(work_spin.get())))
        work_spin.delete(0,"end"); work_spin.insert(0,"25")
        work_spin.pack(side="left",padx=2)
        tk.Label(cfg,text="Break:",bg=BG2,fg=TEXT3,font=FONT_TINY).pack(side="left",padx=(8,0))
        break_spin = tk.Spinbox(cfg,from_=1,to=30,width=3,bg=BG3,fg=TEXT,
                                relief="flat",font=FONT_TINY,
                                command=lambda: setattr(pom,"break_mins",int(break_spin.get())))
        break_spin.delete(0,"end"); break_spin.insert(0,"5")
        break_spin.pack(side="left",padx=2)

        win.protocol("WM_DELETE_WINDOW", lambda: (pom.stop(), win.destroy()))

    # ── SMART SUGGESTIONS ────────────────────────────────────
    def _check_smart_suggestions(self):
        """Analyze patterns and show smart suggestions."""
        try:
            import datetime as _dt, time as _t
            from memory import get_habits, get_db as _mgdb
            today = _dt.date.today()
            conn = _mgdb()

            suggestions = []

            # Habits not logged in 2+ days
            habits = get_habits()
            for h in habits:
                last = conn.execute(
                    "SELECT MAX(date_str) FROM habit_completions WHERE habit_id=?",
                    (h["id"],)
                ).fetchone()[0]
                if last:
                    last_date = _dt.date.fromisoformat(last)
                    gap = (today - last_date).days
                    if gap >= 2:
                        suggestions.append(f"◈ '{h['name']}' hasn't been logged in {gap} days")

            # Overdue tasks
            goals = get_goals()
            now_ts = _t.time()
            overdue = [g for g in goals if g.get("due_date") and
                      g["due_date"] < now_ts and g["status"] != "done"]
            if overdue:
                suggestions.append(f"⚠ {len(overdue)} task(s) are overdue")

            # No journal entry today
            today_entries = conn.execute(
                "SELECT COUNT(*) FROM journal WHERE date(timestamp,'unixepoch')=?",
                (today.isoformat(),)
            ).fetchone()[0]
            if today_entries == 0 and _dt.datetime.now().hour >= 20:
                suggestions.append("✦ You haven't written a journal entry today")

            conn.close()

            if suggestions and not getattr(self,"_suggestions_shown_today",False):
                self._suggestions_shown_today = True
                msg = "💡 Suggestions:\n" + "\n".join(f"  {s}" for s in suggestions[:3])
                self.after(0, lambda: self.show_toast(msg, color=BG3, duration=8000))

        except: pass
        self.after(3600000, self._check_smart_suggestions)  # hourly

