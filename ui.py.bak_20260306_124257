            from search_local import search_all, result_count
            results = search_all(query)
            total = result_count(results)
            if not results:
                self._show_search_results(query, {})
                return
            self._show_search_results(query, results)
        except Exception as e:
            self.append_chat("system", f"Search error: {e}")

    def _show_search_results(self, query, results):
        """Show search results in side panel."""
        if not self.panel_open: self.toggle_panel()
        self._clear_panel()
        self.panel_title.config(text=f"SEARCH: {query[:20]}")
        sf, inner = scrollable(self.panel_content)
        sf.pack(fill="both", expand=True)

        from search_local import result_count
        total = result_count(results)
        tk.Label(inner, text=f"{total} result(s) for  \"{query}\"",
                 bg=BG2, fg=TEXT3, font=FONT_TINY, padx=10).pack(anchor="w", pady=(8,4))

        if not results:
            tk.Label(inner, text="Nothing found.",
                     bg=BG2, fg=TEXT3, font=FONT_SMALL, pady=20).pack()
            return

        type_config = {
            "tasks":    ("✓ TASKS",    ACCENT,  lambda g: self._goal_card(inner, g)),
            "habits":   ("◈ HABITS",   ACCENT2, lambda h: self._habit_search_card(inner, h)),
            "journal":  ("✦ JOURNAL",  ACCENT3, lambda j: self._journal_search_card(inner, j)),
            "calendar": ("◷ CALENDAR", WARN,    lambda e: self._event_search_card(inner, e)),
        }
        for key, (label, color, render_fn) in type_config.items():
            if key not in results: continue
            tk.Label(inner, text=label, bg=BG2, fg=color,
                     font=("Segoe UI",8,"bold"), padx=10).pack(anchor="w", pady=(10,2))
            for item in results[key][:8]:
                render_fn(item)

