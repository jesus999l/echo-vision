    def _ev_type(self,ev):
        t=ev.get("title","")
        if "Journal:" in t or any(t.startswith(e) for e in ["🙂","😔","😐","😊","🤩"]): return "journal"
        if "Habit:" in t or t.startswith("◈"): return "habit"
        if "Goal:" in t or "Due:" in t or t.startswith("🎯"): return "goal"
        return "event"

    def _filter_events(self,events):
        out=[]
        for ev in events:
            if not isinstance(ev,dict): ev={k:ev[k] for k in ev.keys()}
            t=self._ev_type(ev)
            if self.cal_filters.get(t,True):
                out.append(ev)
        if self.cal_sort=="newest":
            out.sort(key=lambda e:e["start_time"],reverse=True)
        else:
            out.sort(key=lambda e:e["start_time"])
        return out

    def _page_calendar(self):
        self._show_full_calendar()



