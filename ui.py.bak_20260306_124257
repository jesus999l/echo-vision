# Page data cache - avoid repeated DB queries
_PAGE_CACHE = {}
_PAGE_CACHE_TIME = {}
CACHE_TTL = 30  # seconds

def _cached(key, fn):
    import time
    now = time.time()
    if key not in _PAGE_CACHE or now - _PAGE_CACHE_TIME.get(key,0) > CACHE_TTL:
        _PAGE_CACHE[key] = fn()
        _PAGE_CACHE_TIME[key] = now
    return _PAGE_CACHE[key]

def _invalidate_cache(key=None):
    if key:
        _PAGE_CACHE.pop(key,None)
        _PAGE_CACHE_TIME.pop(key,None)
    else:
        _PAGE_CACHE.clear()
        _PAGE_CACHE_TIME.clear()
