        new_w=max(220,min(700,self._panel_width+dx))
        self._panel_width=new_w
        self.side_panel.configure(width=new_w)
        self.side_panel.grid_propagate(False)
        self.update_idletasks()
        pass  # divider removed

    def open_page(self,page,panel=1):
        self.active_page=page
        if page=="calendar":
            self._show_full_calendar()
        else:
            self._render_page_main(page)
        if self.panel_open:
            if load_settings().get("menu_stay_open", True):
                self.side_panel.lift()
            else:
                self.side_panel.place_forget()
                self.panel_open=False

    def _render_page_main(self,page):
        """Render page with cache - build once, show/hide after."""
        if not hasattr(self,"_page_frames"): self._page_frames={}
        if not hasattr(self,"_page_dirty"): self._page_dirty={}
        # Hide current page
        if hasattr(self,"main_content") and self.main_content.winfo_exists():
            self.main_content.place_forget()
        # Use cached if clean
        if page in self._page_frames and not self._page_dirty.get(page,False) and self._page_frames[page].winfo_exists():
            self._page_frames[page].place(x=0,y=44,relwidth=1,relheight=1,height=-44)
            self._page_frames[page].lift()
            self.main_content=self._page_frames[page]
            return
        # Build new frame
        if page in self._page_frames:
            try: self._page_frames[page].destroy()
            except: pass
        frame=tk.Frame(self.main_area,bg=BG)
        frame.place(x=0,y=44,relwidth=1,relheight=1,height=-44)
        frame.lift()
        self.main_content=frame
        orig=self.panel_content
        self.panel_content=frame
        pages={
            "tasks":    self._page_tasks,
            "habits":   self._page_habits,
            "journal":  self._page_journal,
            "settings": self._page_settings,
        }
        if page in pages:
            try:
                pages[page]()
            except Exception as e:
                import traceback; traceback.print_exc()
                tk.Label(frame,text=f"Error: {e}",bg=BG,fg=DANGER,
                        font=FONT_SMALL,wraplength=400).pack(padx=20,pady=20)
        self.panel_content=orig
        self._page_frames[page]=frame
        self._page_dirty[page]=False

    def _clear_panel(self):
        for w in self.panel_content.winfo_children():
            w.destroy()


