        self.models=[]
        from config import DEFAULT_MODEL
        self.model.set(DEFAULT_MODEL)
        # Fetch models in background - don't block UI
        def _load_models():
            try:
                models = fetch_available_models()
                def _apply():
                    self.models = models
                    if DEFAULT_MODEL in models:
                        self.model.set(DEFAULT_MODEL)
                    elif models:
                        self.model.set(models[0])
                    # Refresh model dropdown if it exists
                    try:
                        menu = self.model_menu["menu"]
                        menu.delete(0,"end")
                        for m in models:
                            menu.add_command(label=m,command=lambda v=m:self.model.set(v))
                    except: pass
                self.after(0, _apply)
            except: pass
        import threading
        threading.Thread(target=_load_models,daemon=True).start()
        self.panel_open=False; self.chat_open=True
        self.active_page=None
        self.cal_view="month"
        self.cal_date=datetime.date.today()
