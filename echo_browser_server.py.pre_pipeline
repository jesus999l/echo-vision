"""
echo_browser_server.py — Echo TV Launcher + sidebar server.
XMB wheel: 3D perspective carousel, last-played info, auto-cycling themes.
0.0.0.0:59996
"""
import json, os, sys, sqlite3, shutil, tempfile, threading, time
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse
import urllib.request

sys.path.insert(0, os.path.expanduser("~/vision_assistant"))
try:
    from echo_kb_context import get_kb_context, get_kb_summary
    _kb_ready = True
except ImportError:
    _kb_ready = False
    def get_kb_context(q): return ""
    def get_kb_summary(): return "KB unavailable."

PORT = 59996
FF_PROFILE = os.path.expanduser("~/.mozilla/firefox/sjkuigqa.default-release")
PLACES_DB  = os.path.join(FF_PROFILE, "places.sqlite")
INTERESTS_FILE = os.path.expanduser("~/vision_assistant/echo_interests.json")
AVAILABLE_MODELS = [
    {"id":"qwen3-fast:4b",   "name":"Qwen3 Fast",  "type":"ollama"},
    {"id":"phi4-mini:latest","name":"Phi4 Mini",   "type":"ollama"},
    {"id":"gemma3:latest",   "name":"Gemma 3",     "type":"ollama"},
    {"id":"claude",          "name":"Claude API",  "type":"claude"},
]
_current_model = "qwen3-fast:4b"

TV_HTML = r"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920,initial-scale=1">
<title>Echo</title>
<link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Exo+2:wght@200;300;400;600&display=swap" rel="stylesheet">
<style>
:root {
  --c:    #4fa3e0;
  --c2:   #2a6fa8;
  --bg:   #020610;
  --bg2:  #050d20;
  --glow: rgba(79,163,224,0.5);
  --tr: 0.45s cubic-bezier(0.4,0,0.2,1);
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100vw;height:100vh;overflow:hidden;
  background:var(--bg);color:#fff;
  font-family:'Exo 2',sans-serif;cursor:none;user-select:none;}

/* theme transition on root */
:root{transition:--c 1.2s,--bg 1.2s,--bg2 1.2s;}

/* scanlines */
body::after{content:'';position:fixed;inset:0;z-index:900;pointer-events:none;
  background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,0.055) 3px,rgba(0,0,0,0.055) 4px);}

/* ── CANVAS ── */
#bg{position:fixed;inset:0;z-index:0;}

/* ── VIGNETTE ── */
.vignette{position:fixed;inset:0;z-index:1;pointer-events:none;
  background:radial-gradient(ellipse 110% 90% at 50% 50%,transparent 35%,rgba(0,0,0,0.75) 100%);}

/* ── TOPBAR ── */
.topbar{position:fixed;top:0;left:0;right:0;z-index:50;
  display:flex;justify-content:space-between;align-items:flex-start;
  padding:24px 64px 0;}
.logo{font-family:'Syncopate',sans-serif;font-size:11px;font-weight:700;
  letter-spacing:10px;color:var(--c);
  text-shadow:0 0 20px var(--glow);
  opacity:0.85;}
.topright{text-align:right;}
.clock{font-family:'Syncopate',sans-serif;font-size:30px;font-weight:400;
  letter-spacing:4px;line-height:1;
  text-shadow:0 0 15px var(--glow);}
.date{font-size:10px;letter-spacing:3px;color:rgba(255,255,255,0.3);
  text-transform:uppercase;margin-top:5px;}
.statusrow{display:flex;gap:14px;justify-content:flex-end;margin-top:7px;}
.spill{display:flex;align-items:center;gap:5px;font-size:9px;letter-spacing:2px;
  color:rgba(255,255,255,0.25);text-transform:uppercase;}
.sdot{width:5px;height:5px;border-radius:50%;background:var(--c);
  box-shadow:0 0 7px var(--glow);}

/* ── THEME BADGE ── */
.theme-badge{position:fixed;top:28px;left:50%;transform:translateX(-50%);
  z-index:50;font-size:9px;letter-spacing:5px;text-transform:uppercase;
  color:rgba(255,255,255,0.2);font-family:'Syncopate',sans-serif;
  transition:opacity 1s;}
.theme-badge.flash{color:var(--c);text-shadow:0 0 12px var(--glow);}

/* ── WHEEL CONTAINER ── */
.wheel-wrap{
  position:fixed;bottom:0;left:0;right:0;
  height:72vh;
  display:flex;align-items:flex-end;
  padding:0 0 40px 0;
  z-index:10;
  perspective:1100px;
  perspective-origin:38% 55%;
}

.wheel{
  width:100%;
  display:flex;flex-direction:column;
  align-items:flex-start;
  gap:0;
  transform-style:preserve-3d;
  padding-left:100px;
}

/* ── ROW ── */
.row{
  display:flex;align-items:center;
  width:100%;
  padding:0;
  transition:transform var(--tr),opacity var(--tr),filter var(--tr);
  transform-origin:left center;
  transform-style:preserve-3d;
  position:relative;
}

/* applied by JS based on distance from active */
.row[data-dist="0"]{
  transform:translateZ(0px) rotateX(0deg);
  opacity:1;filter:none;
}
.row[data-dist="1"],.row[data-dist="-1"]{
  transform:translateZ(-90px) rotateX(22deg);
  opacity:0.45;filter:brightness(0.6);
}
.row[data-dist="2"],.row[data-dist="-2"]{
  transform:translateZ(-170px) rotateX(40deg);
  opacity:0.2;filter:brightness(0.35);
}
.row[data-dist="3"],.row[data-dist="-3"]{
  transform:translateZ(-240px) rotateX(55deg);
  opacity:0.08;filter:brightness(0.2);
}
.row[data-dist="far"]{
  transform:translateZ(-300px) rotateX(68deg);
  opacity:0.0;pointer-events:none;
}
/* negative dist flips the rotateX */
.row[data-dist="-1"]{transform:translateZ(-90px) rotateX(-22deg);}
.row[data-dist="-2"]{transform:translateZ(-170px) rotateX(-40deg);}
.row[data-dist="-3"]{transform:translateZ(-240px) rotateX(-55deg);}
.row[data-dist="far-neg"]{transform:translateZ(-300px) rotateX(-68deg);opacity:0;pointer-events:none;}

/* ── CAT LABEL ── */
.cat-label{
  width:200px;flex-shrink:0;
  display:flex;align-items:center;gap:14px;
  padding-right:16px;
  transition:all var(--tr);
}
.cat-icon-wrap{
  width:44px;height:44px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.06);
  transition:all var(--tr);font-size:20px;
}
.row[data-dist="0"] .cat-icon-wrap{
  background:rgba(79,163,224,0.12);
  border-color:var(--c);
  box-shadow:0 0 18px var(--glow);
  font-size:22px;
}
.cat-name{font-size:10px;letter-spacing:4px;text-transform:uppercase;
  color:rgba(255,255,255,0.25);font-weight:300;transition:color var(--tr);}
.row[data-dist="0"] .cat-name{color:rgba(255,255,255,0.85);}

/* separator line */
.cat-sep{
  width:1px;height:44px;flex-shrink:0;margin-right:20px;
  background:linear-gradient(180deg,transparent,var(--c),transparent);
  opacity:0;transition:opacity var(--tr);
}
.row[data-dist="0"] .cat-sep{opacity:0.4;}

/* ── ITEMS TRACK ── */
.items-track{
  display:flex;align-items:center;gap:16px;
  overflow:hidden;padding:12px 0;
  flex:1;
  /* mask edges */
  -webkit-mask:linear-gradient(90deg,transparent 0%,black 4%,black 80%,transparent 100%);
  mask:linear-gradient(90deg,transparent 0%,black 4%,black 80%,transparent 100%);
}

/* ── ITEM ── */
.item{
  flex-shrink:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:8px;
  transition:all var(--tr);
  position:relative;cursor:pointer;
}

/* inactive row items */
.row:not([data-dist="0"]) .item{
  width:70px;height:56px;border-radius:8px;
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.04);
}
.row:not([data-dist="0"]) .item-icon{font-size:18px;color:rgba(255,255,255,0.3);}
.row:not([data-dist="0"]) .item-name{font-size:8px;color:rgba(255,255,255,0.25);letter-spacing:1px;}
.row:not([data-dist="0"]) .item-sub{display:none;}

/* active row items */
.row[data-dist="0"] .item{
  width:110px;height:84px;border-radius:10px;
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.07);
  opacity:0.65;
}
.row[data-dist="0"] .item-icon{font-size:28px;color:rgba(255,255,255,0.55);}
.row[data-dist="0"] .item-name{font-size:10px;letter-spacing:1.5px;font-weight:600;
  color:rgba(255,255,255,0.55);}

/* selected item in active row */
.row[data-dist="0"] .item.sel{
  width:128px;height:100px;border-radius:12px;
  background:rgba(79,163,224,0.1);
  border-color:var(--c);
  box-shadow:0 0 28px var(--glow),0 10px 40px rgba(0,0,0,0.5);
  opacity:1;
  transform:translateY(-8px) scale(1.06);
}
.row[data-dist="0"] .item.sel .item-icon{color:#fff;font-size:32px;
  filter:drop-shadow(0 0 8px var(--glow));}
.row[data-dist="0"] .item.sel .item-name{color:#fff;}
.row[data-dist="0"] .item.sel .item-sub{color:var(--c);opacity:0.9;}

/* corner accent */
.row[data-dist="0"] .item.sel::before{
  content:'';position:absolute;top:7px;right:7px;
  width:7px;height:7px;
  border-top:1.5px solid var(--c);
  border-right:1.5px solid var(--c);
}
.row[data-dist="0"] .item.sel::after{
  content:'';position:absolute;bottom:7px;left:7px;
  width:7px;height:7px;
  border-bottom:1.5px solid var(--c);
  border-left:1.5px solid var(--c);
}

.item-icon{transition:all var(--tr);line-height:1;}
.item-name{font-size:9px;text-transform:uppercase;text-align:center;
  letter-spacing:1px;transition:all var(--tr);}
.item-sub{font-size:8px;letter-spacing:1px;color:var(--c);opacity:0;
  text-align:center;white-space:nowrap;overflow:hidden;
  max-width:110px;text-overflow:ellipsis;
  transition:opacity var(--tr);}

/* ── INFO STRIP ── */
.info-strip{
  position:fixed;bottom:18px;left:100px;right:60px;z-index:50;
  display:flex;align-items:center;justify-content:space-between;
}
.info-left{display:flex;flex-direction:column;gap:4px;}
.info-title{font-family:'Syncopate',sans-serif;font-size:11px;
  letter-spacing:3px;color:rgba(255,255,255,0.7);transition:all 0.3s;}
.info-meta{font-size:10px;letter-spacing:2px;color:rgba(255,255,255,0.25);
  text-transform:uppercase;}
.info-right{display:flex;align-items:center;gap:20px;}
.hint{display:flex;align-items:center;gap:6px;font-size:9px;
  letter-spacing:2px;color:rgba(255,255,255,0.2);text-transform:uppercase;}
.key{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);
  border-radius:3px;padding:2px 7px;font-family:'Syncopate',sans-serif;
  font-size:7px;color:var(--c);}

/* ── MUSIC BARS ── */
.mbars{display:flex;align-items:flex-end;gap:3px;height:14px;margin-left:16px;}
.mbars span{width:2px;background:var(--c);border-radius:1px;
  animation:mbar 1.1s ease-in-out infinite;}
.mbars span:nth-child(1){height:6px;animation-delay:0s;}
.mbars span:nth-child(2){height:12px;animation-delay:0.15s;}
.mbars span:nth-child(3){height:8px;animation-delay:0.28s;}
.mbars span:nth-child(4){height:14px;animation-delay:0.08s;}
.mbars span:nth-child(5){height:5px;animation-delay:0.22s;}
@keyframes mbar{0%,100%{transform:scaleY(0.3);}50%{transform:scaleY(1);}}

/* ── CHAT OVERLAY ── */
.overlay{display:none;position:fixed;inset:0;z-index:800;
  background:rgba(2,6,16,0.93);backdrop-filter:blur(14px);
  align-items:center;justify-content:center;}
.overlay.show{display:flex;}
.chat-box{width:700px;
  background:rgba(5,12,28,0.97);
  border:1px solid rgba(79,163,224,0.35);border-radius:16px;padding:34px;
  box-shadow:0 0 50px rgba(79,163,224,0.2);}
.chat-title{font-family:'Syncopate',sans-serif;font-size:10px;letter-spacing:6px;
  color:var(--c);margin-bottom:22px;text-transform:uppercase;}
.chat-log{min-height:200px;max-height:300px;overflow-y:auto;
  display:flex;flex-direction:column;gap:10px;margin-bottom:18px;scrollbar-width:none;}
.msg{padding:10px 15px;border-radius:9px;font-size:13px;line-height:1.65;}
.msg.user{background:rgba(79,163,224,0.08);border:1px solid rgba(79,163,224,0.18);
  color:#8ac8f0;align-self:flex-end;max-width:82%;}
.msg.echo{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);
  align-self:flex-start;max-width:94%;}
.msg.echo b{display:block;font-size:8px;letter-spacing:4px;color:var(--c);
  margin-bottom:5px;text-transform:uppercase;}
.chat-inp{width:100%;background:rgba(255,255,255,0.04);
  border:1px solid rgba(79,163,224,0.25);border-radius:9px;
  padding:13px 17px;color:#fff;font-family:'Exo 2',sans-serif;font-size:14px;outline:none;
  transition:border-color 0.2s;}
.chat-inp:focus{border-color:var(--c);}

/* voice ring */
.vring-wrap{display:none;position:fixed;inset:0;z-index:700;
  align-items:center;justify-content:center;flex-direction:column;gap:18px;
  background:rgba(2,6,16,0.7);}
.vring-wrap.show{display:flex;}
.vring{width:110px;height:110px;border-radius:50%;border:1.5px solid var(--c);
  display:flex;align-items:center;justify-content:center;font-size:32px;
  animation:pulse 1.4s ease-in-out infinite;box-shadow:0 0 30px var(--glow);}
@keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.1);}}
.vlabel{font-family:'Syncopate',sans-serif;font-size:9px;letter-spacing:5px;
  color:var(--c);text-transform:uppercase;}
</style>
</head>
<body>
<canvas id="bg"></canvas>
<div class="vignette"></div>

<div class="topbar">
  <div class="logo">ECHO OS</div>
  <div class="topright">
    <div class="clock" id="clock">00:00</div>
    <div class="date" id="dateline">—</div>
    <div class="statusrow">
      <div class="spill"><div class="sdot" id="sdot"></div><span id="stxt">Online</span></div>
      <div class="spill"><div class="sdot"></div><span>Local AI</span></div>
    </div>
  </div>
</div>
<div class="theme-badge" id="themeBadge">Glacier</div>

<!-- XMB WHEEL -->
<div class="wheel-wrap">
<div class="wheel" id="wheel">

  <div class="row" data-row="0">
    <div class="cat-label">
      <div class="cat-icon-wrap">◉</div>
      <div class="cat-name">Echo</div>
    </div>
    <div class="cat-sep"></div>
    <div class="items-track" id="t0">
      <div class="item sel" data-action="echo-chat" data-desc="AI Chat Interface" data-key="echo_chat">
        <div class="item-icon">💬</div><div class="item-name">Chat</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="echo-voice" data-desc="Voice Assistant" data-key="echo_voice">
        <div class="item-icon">🎤</div><div class="item-name">Voice</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="echo-status" data-desc="System Status" data-key="echo_status">
        <div class="item-icon">⚡</div><div class="item-name">Status</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="echo-memory" data-desc="Knowledge Base" data-key="echo_memory">
        <div class="item-icon">🧠</div><div class="item-name">Memory</div><div class="item-sub"></div>
      </div>
    </div>
  </div>

  <div class="row" data-row="1">
    <div class="cat-label">
      <div class="cat-icon-wrap">🎬</div>
      <div class="cat-name">Entertainment</div>
    </div>
    <div class="cat-sep"></div>
    <div class="items-track" id="t1">
      <div class="item" data-action="launch" data-pkg="com.google.android.youtube" data-desc="YouTube" data-key="youtube">
        <div class="item-icon">▶</div><div class="item-name">YouTube</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="com.netflix.ninja" data-desc="Netflix" data-key="netflix">
        <div class="item-icon">🎞</div><div class="item-name">Netflix</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="com.plexapp.android" data-desc="Plex" data-key="plex">
        <div class="item-icon">⬡</div><div class="item-name">Plex</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="org.xbmc.kodi" data-desc="Kodi" data-key="kodi">
        <div class="item-icon">⊕</div><div class="item-name">Kodi</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="com.amazon.amazonvideo.livingroom" data-desc="Prime Video" data-key="prime">
        <div class="item-icon">📦</div><div class="item-name">Prime</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="com.crunchyroll.crunchyroid" data-desc="Crunchyroll" data-key="crunchyroll">
        <div class="item-icon">🍥</div><div class="item-name">Crunchyroll</div><div class="item-sub"></div>
      </div>
    </div>
  </div>

  <div class="row" data-row="2">
    <div class="cat-label">
      <div class="cat-icon-wrap">🎵</div>
      <div class="cat-name">Music</div>
    </div>
    <div class="cat-sep"></div>
    <div class="items-track" id="t2">
      <div class="item" data-action="launch" data-pkg="com.google.android.apps.youtube.music" data-desc="YouTube Music" data-key="ytmusic">
        <div class="item-icon">🎵</div><div class="item-name">YT Music</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="com.spotify.music" data-desc="Spotify" data-key="spotify">
        <div class="item-icon">🎧</div><div class="item-name">Spotify</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="music-toggle" data-desc="Ambient Sound" data-key="ambient">
        <div class="item-icon">🔊</div><div class="item-name">Ambient</div><div class="item-sub"></div>
      </div>
    </div>
  </div>

  <div class="row" data-row="3">
    <div class="cat-label">
      <div class="cat-icon-wrap">📱</div>
      <div class="cat-name">Apps</div>
    </div>
    <div class="cat-sep"></div>
    <div class="items-track" id="t3">
      <div class="item" data-action="launch" data-pkg="com.android.chrome" data-desc="Browser" data-key="chrome">
        <div class="item-icon">🌐</div><div class="item-name">Browser</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="com.google.android.tvlauncher" data-desc="All Apps" data-key="allapps">
        <div class="item-icon">⊞</div><div class="item-name">All Apps</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="launch" data-pkg="com.google.android.play.games" data-desc="Games" data-key="games">
        <div class="item-icon">🎮</div><div class="item-name">Games</div><div class="item-sub"></div>
      </div>
    </div>
  </div>

  <div class="row" data-row="4">
    <div class="cat-label">
      <div class="cat-icon-wrap">⚙</div>
      <div class="cat-name">Settings</div>
    </div>
    <div class="cat-sep"></div>
    <div class="items-track" id="t4">
      <div class="item" data-action="launch" data-pkg="com.android.tv.settings" data-desc="TV Settings" data-key="tvsettings">
        <div class="item-icon">📺</div><div class="item-name">Display</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="model-toggle" data-desc="Switch AI Model" data-key="aimodel">
        <div class="item-icon">🤖</div><div class="item-name">AI Model</div><div class="item-sub"></div>
      </div>
      <div class="item" data-action="music-toggle" data-desc="Toggle Music" data-key="musictoggle">
        <div class="item-icon">🎼</div><div class="item-name">Music</div><div class="item-sub"></div>
      </div>
    </div>
  </div>

</div>
</div>

<div class="info-strip">
  <div class="info-left">
    <div class="info-title" id="infoTitle">Echo OS</div>
    <div class="info-meta" id="infoMeta">Navigate with D-pad · OK to open · Mic for voice</div>
  </div>
  <div class="info-right">
    <div class="hint"><span class="key">↑↓</span>Row</div>
    <div class="hint"><span class="key">←→</span>Item</div>
    <div class="hint"><span class="key">OK</span>Open</div>
    <div class="hint"><span class="key">MIC</span>Voice</div>
    <div class="mbars" id="mbars" style="display:none">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
</div>

<!-- CHAT OVERLAY -->
<div class="overlay" id="chatOverlay">
  <div class="chat-box">
    <div class="chat-title">◉ Echo — AI Interface</div>
    <div class="chat-log" id="chatLog">
      <div class="msg echo"><b>Echo</b>System online. How can I help?</div>
    </div>
    <input class="chat-inp" id="chatInp" placeholder="Ask Echo..." autocomplete="off" spellcheck="false">
  </div>
</div>

<!-- VOICE RING -->
<div class="vring-wrap" id="vringWrap">
  <div class="vring">🎤</div>
  <div class="vlabel">Listening</div>
</div>

<script>
// ── THEMES ──
const THEMES=[
  {name:'Glacier', c:'#4fa3e0', glow:'rgba(79,163,224,0.5)',  bg:'#020610', bg2:'#050d20'},
  {name:'Aurora',  c:'#00d4aa', glow:'rgba(0,212,170,0.5)',   bg:'#020f0a', bg2:'#041510'},
  {name:'Nebula',  c:'#a06dff', glow:'rgba(160,109,255,0.5)', bg:'#080514', bg2:'#0c0720'},
  {name:'Ember',   c:'#ff8c42', glow:'rgba(255,140,66,0.5)',  bg:'#0f0600', bg2:'#180d00'},
  {name:'Phantom', c:'#e040a0', glow:'rgba(224,64,160,0.5)',  bg:'#0f0209', bg2:'#180312'},
];
let themeIdx=0;

function applyTheme(t,announce){
  const r=document.documentElement.style;
  r.setProperty('--c',t.c);
  r.setProperty('--glow',t.glow);
  r.setProperty('--bg',t.bg);
  r.setProperty('--bg2',t.bg2);
  document.body.style.background=t.bg;
  if(announce){
    const b=document.getElementById('themeBadge');
    b.textContent=t.name;b.classList.add('flash');
    setTimeout(()=>b.classList.remove('flash'),3000);
  }
}
applyTheme(THEMES[0],false);
// cycle every 90 seconds
setInterval(()=>{
  themeIdx=(themeIdx+1)%THEMES.length;
  applyTheme(THEMES[themeIdx],true);
},90000);

// ── CANVAS WAVES ──
const cv=document.getElementById('bg');
const cx=cv.getContext('2d');
let W,H,T=0;
function resize(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}
resize();window.addEventListener('resize',resize);

function drawBg(){
  cx.clearRect(0,0,W,H);
  const g=cx.createRadialGradient(W*.5,H*.7,0,W*.5,H*.5,W);
  const bg=getComputedStyle(document.documentElement).getPropertyValue('--bg').trim()||'#020610';
  g.addColorStop(0,bg+'cc');g.addColorStop(1,bg);
  cx.fillStyle=g;cx.fillRect(0,0,W,H);
  // waves
  for(let i=0;i<10;i++){
    const ph=i*Math.PI*.35,amp=20+i*10,freq=.0018+i*.00025,spd=.25+i*.08;
    const y0=H*(.15+i*.08);
    cx.beginPath();
    for(let x=0;x<=W;x+=6){
      const y=y0+Math.sin(x*freq+T*spd+ph)*amp+Math.sin(x*freq*1.7+T*(spd*.6))*amp*.25;
      x===0?cx.moveTo(x,y):cx.lineTo(x,y);
    }
    const c=getComputedStyle(document.documentElement).getPropertyValue('--c').trim()||'#4fa3e0';
    cx.strokeStyle=hexToRgba(c,Math.max(0.004,.014-i*.001));
    cx.lineWidth=1;cx.stroke();
  }
  T+=.007;requestAnimationFrame(drawBg);
}

function hexToRgba(hex,a){
  const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${a})`;
}
drawBg();

// ── CLOCK ──
function tick(){
  const n=new Date(),h=String(n.getHours()).padStart(2,'0'),m=String(n.getMinutes()).padStart(2,'0');
  document.getElementById('clock').textContent=h+':'+m;
  const D=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const M=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  document.getElementById('dateline').textContent=D[n.getDay()]+' · '+M[n.getMonth()]+' '+n.getDate();
}
tick();setInterval(tick,1000);

// ── LAST PLAYED ──
function getLastPlayed(key){
  try{
    const d=localStorage.getItem('lp_'+key);
    if(!d)return null;
    return JSON.parse(d);
  }catch{return null;}
}
function setLastPlayed(key,name){
  try{localStorage.setItem('lp_'+key,JSON.stringify({name,ts:Date.now()}));}catch{}
}
function timeAgo(ts){
  const s=Math.floor((Date.now()-ts)/1000);
  if(s<60)return 'just now';
  if(s<3600)return Math.floor(s/60)+'m ago';
  if(s<86400)return Math.floor(s/3600)+'h ago';
  return Math.floor(s/86400)+'d ago';
}

function refreshSubtitles(){
  document.querySelectorAll('.item').forEach(it=>{
    const key=it.dataset.key;
    const sub=it.querySelector('.item-sub');
    if(!sub||!key)return;
    const lp=getLastPlayed(key);
    sub.textContent=lp?'Last: '+timeAgo(lp.ts):'';
    sub.style.opacity=lp?'1':'0';
  });
}

// ── NAV STATE ──
const ROWS=5;
const rowLen=[4,6,3,3,3];
let row=0,col=0;

function dist(i){return i-row;}

function updateWheel(){
  const rows=document.querySelectorAll('.row');
  rows.forEach((r,i)=>{
    const d=i-row;
    let attr;
    if(d===0)attr='0';
    else if(d===1)attr='1';
    else if(d===-1)attr='-1';
    else if(d===2)attr='2';
    else if(d===-2)attr='-2';
    else if(d===3)attr='3';
    else if(d===-3)attr='-3';
    else if(d>3)attr='far';
    else attr='far-neg';
    r.setAttribute('data-dist',attr);
    // update items visibility
    const items=r.querySelectorAll('.item');
    items.forEach((it,j)=>it.classList.toggle('sel',i===row&&j===col));
  });
  // update selected item subtitle
  const selItem=document.querySelector(`.row[data-row="${row}"] .item.sel`);
  if(selItem){
    const key=selItem.dataset.key;
    const lp=getLastPlayed(key);
    document.getElementById('infoTitle').textContent=selItem.dataset.desc||'';
    document.getElementById('infoMeta').textContent=lp?'Last opened: '+timeAgo(lp.ts):'';
    // scroll track
    const track=document.getElementById('t'+row);
    if(track){
      const itemW=126;
      track.scrollLeft=Math.max(0,col*itemW-300);
    }
  }
}
updateWheel();
refreshSubtitles();
setInterval(refreshSubtitles,30000);

// ── KEYBOARD ──
let overlayOpen=false;
document.addEventListener('keydown',e=>{
  if(overlayOpen){
    if(e.key==='Escape'||e.key==='Backspace')closeOverlay();
    return;
  }
  switch(e.key){
    case'ArrowUp':   row=Math.max(0,row-1);col=Math.min(col,rowLen[row]-1);updateWheel();e.preventDefault();break;
    case'ArrowDown': row=Math.min(ROWS-1,row+1);col=Math.min(col,rowLen[row]-1);updateWheel();e.preventDefault();break;
    case'ArrowLeft': col=Math.max(0,col-1);updateWheel();e.preventDefault();break;
    case'ArrowRight':col=Math.min(rowLen[row]-1,col+1);updateWheel();e.preventDefault();break;
    case'Enter':case' ':activate();e.preventDefault();break;
    case'Escape':case'Backspace':e.preventDefault();break;
    case'F5':case'MicrophoneToggle':startVoice();e.preventDefault();break;
  }
});

function activate(){
  const it=document.querySelector(`.row[data-row="${row}"] .item.sel`);
  if(!it)return;
  const key=it.dataset.key,a=it.dataset.action;
  setLastPlayed(key,it.dataset.desc||key);
  refreshSubtitles();
  if(a==='echo-chat')openChat('');
  else if(a==='echo-voice')startVoice();
  else if(a==='echo-status')openChat('What is your current system status?');
  else if(a==='echo-memory')openChat('What do you remember about me and my interests?');
  else if(a==='launch')launchApp(it.dataset.pkg,it.dataset.desc);
  else if(a==='music-toggle')toggleMusic();
  else if(a==='model-toggle')cycleModel();
}

// ── LAUNCH ──
async function launchApp(pkg,name){
  if(!pkg)return;
  try{
    await fetch('/launch',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({package:pkg})});
  }catch{}
}

// ── CHAT ──
function openChat(prefill){
  overlayOpen=true;
  document.getElementById('chatOverlay').classList.add('show');
  const inp=document.getElementById('chatInp');inp.value=prefill||'';
  setTimeout(()=>inp.focus(),80);
  if(prefill)sendChat(prefill);
}
function closeOverlay(){
  overlayOpen=false;
  document.getElementById('chatOverlay').classList.remove('show');
}
document.getElementById('chatInp').addEventListener('keydown',e=>{
  if(e.key==='Enter'){const v=e.target.value.trim();if(v){sendChat(v);e.target.value='';}e.preventDefault();}
  if(e.key==='Escape')closeOverlay();
});

async function sendChat(msg){
  const log=document.getElementById('chatLog');
  const u=document.createElement('div');u.className='msg user';u.textContent=msg;log.appendChild(u);
  const th=document.createElement('div');th.className='msg echo';
  th.innerHTML='<b>Echo</b><em style="opacity:.4">Thinking...</em>';
  log.appendChild(th);log.scrollTop=9999;
  try{
    const r=await fetch('/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg})});
    const d=await r.json();
    th.innerHTML='<b>Echo</b>'+(d.response||d.error||'—');
  }catch{th.innerHTML='<b>Echo</b>Connection error';}
  log.scrollTop=9999;
}

// ── VOICE ──
function startVoice(){
  if(!('webkitSpeechRecognition'in window||'SpeechRecognition'in window)){openChat('Voice not available in this browser.');return;}
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  const rec=new SR();rec.lang='en-US';rec.interimResults=false;
  document.getElementById('vringWrap').classList.add('show');
  rec.onresult=e=>{
    document.getElementById('vringWrap').classList.remove('show');
    handleVoice(e.results[0][0].transcript);
  };
  rec.onerror=rec.onend=()=>document.getElementById('vringWrap').classList.remove('show');
  rec.start();
}
function handleVoice(t){
  const s=t.toLowerCase();
  const appMap={'youtube':'com.google.android.youtube','netflix':'com.netflix.ninja',
    'plex':'com.plexapp.android','kodi':'org.xbmc.kodi',
    'spotify':'com.spotify.music','prime':'com.amazon.amazonvideo.livingroom'};
  for(const[name,pkg] of Object.entries(appMap)){
    if(s.includes(name)){launchApp(pkg,name);return;}
  }
  if(s.includes('music'))toggleMusic();
  else openChat(t);
}

// ── AMBIENT MUSIC ──
let aCtx=null,musicOn=false,mNodes=[];
function toggleMusic(){
  musicOn?stopMusic():startMusic();
}
function startMusic(){
  if(!aCtx)aCtx=new(window.AudioContext||window.webkitAudioContext)();
  musicOn=true;
  document.getElementById('mbars').style.display='flex';
  const c=getComputedStyle(document.documentElement).getPropertyValue('--c').trim();
  const freqs=[130.81,164.81,196,246.94,261.63,329.63];
  freqs.forEach((f,i)=>{
    const o=aCtx.createOscillator(),g=aCtx.createGain(),filt=aCtx.createBiquadFilter();
    filt.type='lowpass';filt.frequency.value=600+i*80;
    o.type='sine';o.frequency.value=f;
    const lfo=aCtx.createOscillator(),lg=aCtx.createGain();
    lfo.frequency.value=.2+i*.04;lg.gain.value=.6;
    lfo.connect(lg);lg.connect(o.frequency);
    g.gain.setValueAtTime(0,aCtx.currentTime);
    g.gain.linearRampToValueAtTime(.032,aCtx.currentTime+4+i*.5);
    o.connect(filt);filt.connect(g);g.connect(aCtx.destination);
    lfo.start();o.start();mNodes.push(o,lfo);
  });
  // arp
  let ai=0;const afreqs=[523.25,659.25,783.99,1046.5,523.25,392];
  function arp(){
    if(!musicOn)return;
    const o=aCtx.createOscillator(),g=aCtx.createGain();
    o.type='triangle';o.frequency.value=afreqs[ai%afreqs.length];
    g.gain.setValueAtTime(.012,aCtx.currentTime);
    g.gain.linearRampToValueAtTime(0,aCtx.currentTime+1);
    o.connect(g);g.connect(aCtx.destination);
    o.start();o.stop(aCtx.currentTime+1.1);
    ai++;setTimeout(arp,1800+Math.random()*2200);
  }
  setTimeout(arp,5000);
}
function stopMusic(){
  musicOn=false;
  document.getElementById('mbars').style.display='none';
  mNodes.forEach(n=>{try{n.stop();}catch{}});mNodes=[];
}

// ── MODEL CYCLE ──
const models=['qwen3-fast:4b','phi4-mini:latest','gemma3:latest'];
let mIdx=0;
async function cycleModel(){
  mIdx=(mIdx+1)%models.length;
  await fetch('/model',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:models[mIdx]})});
  openChat('Model switched to '+models[mIdx]);
}

// ── STATUS ──
async function checkStatus(){
  try{
    await fetch('/status');
    document.getElementById('sdot').style.background=getComputedStyle(document.documentElement).getPropertyValue('--c');
    document.getElementById('stxt').textContent='Online';
  }catch{
    document.getElementById('sdot').style.background='#ff4444';
    document.getElementById('stxt').textContent='Offline';
  }
}
checkStatus();setInterval(checkStatus,30000);

// auto-start music on first interaction
document.addEventListener('keydown',()=>{if(!musicOn)startMusic();},{once:true});
</script>
</body>
</html>"""


# ── BACKEND (unchanged) ───────────────────────────────────────────────────────
def _read_places(query, params=()):
    if not os.path.exists(PLACES_DB): return []
    tmp = tempfile.mktemp(suffix=".sqlite")
    try:
        shutil.copy2(PLACES_DB, tmp)
        conn = sqlite3.connect(tmp); conn.row_factory = sqlite3.Row
        rows = conn.execute(query, params).fetchall(); conn.close()
        return [dict(r) for r in rows]
    except Exception as e: print(f"[browser] {e}"); return []
    finally:
        try: os.unlink(tmp)
        except: pass

def get_recent_bookmarks(limit=20):
    return _read_places("""SELECT b.title,p.url,b.dateAdded/1000000 as ts FROM moz_bookmarks b
        JOIN moz_places p ON b.fk=p.id WHERE b.type=1 AND p.url NOT LIKE 'place:%'
        ORDER BY b.dateAdded DESC LIMIT ?""",(limit,))

def get_recent_history(limit=50):
    return _read_places("""SELECT title,url,last_visit_date/1000000 as ts,visit_count FROM moz_places
        WHERE last_visit_date IS NOT NULL AND title IS NOT NULL
        AND url NOT LIKE 'about:%' AND url NOT LIKE 'moz-%'
        ORDER BY last_visit_date DESC LIMIT ?""",(limit,))

def build_interest_profile():
    bookmarks=get_recent_bookmarks(30); history=get_recent_history(100)
    keywords=["warframe","linux","python","ai","gaming","music","privacy","android","ollama","docker","security","tech","anime","modding"]
    all_text=" ".join([(b.get("title") or "")+" "+(b.get("url") or "") for b in bookmarks+history]).lower()
    topics={kw:all_text.count(kw) for kw in keywords if all_text.count(kw)>0}
    sorted_topics=sorted(topics.items(),key=lambda x:x[1],reverse=True)
    profile={"timestamp":time.time(),"top_topics":sorted_topics[:10],"bookmark_count":len(bookmarks),
             "history_count":len(history),"recent_sites":list(set([urlparse(h.get("url","")).netloc for h in history[:20] if h.get("url")]))[:10]}
    with open(INTERESTS_FILE,"w") as f: json.dump(profile,f,indent=2)
    return profile

def get_interests():
    if os.path.exists(INTERESTS_FILE):
        try:
            data=json.load(open(INTERESTS_FILE))
            if time.time()-data.get("timestamp",0)<3600: return data
        except: pass
    return build_interest_profile()

def chat_ollama(message, model="qwen3-fast:4b", context=""):
    system=f"You are Echo, home AI on a TV interface. Interests: {context}. Be concise."
    payload=json.dumps({"model":model,"messages":[{"role":"system","content":system},{"role":"user","content":message}],"stream":False}).encode()
    req=urllib.request.Request("http://127.0.0.1:11434/v1/chat/completions",data=payload,headers={"Content-Type":"application/json"})
    with urllib.request.urlopen(req,timeout=90) as r:
        return json.loads(r.read())["choices"][0]["message"]["content"]

def _get_api_key():
    try:
        cfg=json.load(open(os.path.expanduser("~/vision_assistant/settings.json")))
        key=cfg.get("claude_api_key","")
        if key and key!="YOUR_API_KEY_HERE": return key
    except: pass
    return None

def chat_claude(message,context=""):
    key=_get_api_key()
    if not key: return "Claude API key not configured."
    try:
        payload=json.dumps({"model":"claude-sonnet-4-5","max_tokens":500,"system":f"You are Echo, TV AI. Interests: {context}. Be concise.","messages":[{"role":"user","content":message}]}).encode()
        req=urllib.request.Request("https://api.anthropic.com/v1/messages",data=payload,headers={"Content-Type":"application/json","x-api-key":key,"anthropic-version":"2023-06-01"})
        with urllib.request.urlopen(req,timeout=90) as r:
            return json.loads(r.read())["content"][0]["text"]
    except Exception as e: return f"Error: {e}"

def do_chat(message,model=None):
    global _current_model
    m=model or _current_model
    interests=get_interests()
    ctx=", ".join([t[0] for t in interests.get("top_topics",[])[:5]])
    return chat_claude(message,ctx) if m=="claude" else chat_ollama(message,m,ctx)

class EchoHandler(BaseHTTPRequestHandler):
    def log_message(self,*a): pass
    def _json(self,data,status=200):
        body=json.dumps(data,default=str).encode()
        self.send_response(status)
        self.send_header("Content-Type","application/json")
        self.send_header("Access-Control-Allow-Origin","*")
        self.send_header("Content-Length",str(len(body)))
        self.end_headers(); self.wfile.write(body)
    def _html(self,html):
        body=html.encode()
        self.send_response(200)
        self.send_header("Content-Type","text/html; charset=utf-8")
        self.send_header("Content-Length",str(len(body)))
        self.end_headers(); self.wfile.write(body)
    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin","*")
        self.send_header("Access-Control-Allow-Methods","GET,POST,OPTIONS")
        self.send_header("Access-Control-Allow-Headers","Content-Type")
        self.end_headers()
    def do_GET(self):
        p=urlparse(self.path).path
        if p in("/","/tv"): self._html(TV_HTML)
        elif p=="/status": self._json({"status":"ok","model":_current_model})
        elif p=="/interests": self._json(get_interests())
        elif p=="/bookmarks": self._json(get_recent_bookmarks(15))
        elif p=="/models": self._json(AVAILABLE_MODELS)
        elif p=="/history": self._json(get_recent_history(20))
        else: self._json({"error":"not found"},404)
    def do_POST(self):
        global _current_model
        p=urlparse(self.path).path
        ln=int(self.headers.get("Content-Length",0))
        body=json.loads(self.rfile.read(ln)) if ln else {}
        if p=="/chat":
            msg=body.get("message","")
            if not msg: self._json({"error":"no message"},400); return
            try:
                kb_ctx = get_kb_context(msg) if _kb_ready else ""
                aug = (kb_ctx + "\n\nUser: " + msg) if kb_ctx else msg
                self._json({"response":do_chat(aug,body.get("model")),"model":_current_model})
            except Exception as e: self._json({"error":str(e)},500)
        elif p=="/model":
            m=body.get("model")
            if m: _current_model=m; self._json({"ok":True,"model":m})
            else: self._json({"error":"no model"},400)
        elif p=="/launch":
            pkg=body.get("package","")
            if pkg:
                try:
                    import subprocess
                    subprocess.Popen(["adb","shell","monkey","-p",pkg,"-c","android.intent.category.LAUNCHER","1"])
                    self._json({"ok":True,"package":pkg})
                except Exception as e: self._json({"error":str(e)},500)
            else: self._json({"error":"no package"},400)
        elif p=="/announce":
            text=body.get("text","")
            if text:
                try:
                    from voice import speak; speak(f"Echo here. {text}")
                except: pass
            self._json({"ok":True})
        else: self._json({"error":"not found"},404)

_server=None
def start_browser_server():
    global _server
    try:
        _server=HTTPServer(("0.0.0.0",PORT),EchoHandler)
        t=threading.Thread(target=_server.serve_forever,daemon=True); t.start()
        print(f"[browser] Echo TV → http://0.0.0.0:{PORT}")
        threading.Thread(target=build_interest_profile,daemon=True).start()
        return _server
    except Exception as e: print(f"[browser] Failed: {e}"); return None

if __name__=="__main__":
    print(f"Echo TV server on port {PORT}...")
    start_browser_server()
    print(f"Open http://192.168.4.46:{PORT} on the TV")
    import signal; signal.pause()
